<Project>

  <!-- Dual-host platform selection (WindowsDX vs DesktopVK). -->
  <Import Project="$(MSBuildThisFileDirectory)build/StarDrive.Platform.props"
          Condition="Exists('$(MSBuildThisFileDirectory)build/StarDrive.Platform.props')" />

  <!--
    Suppress CA1416 (platform-compat analyzer) repo-wide.

    WindowsDX targets net8.0-windows. DesktopVK targets net8.0 with STARDIVE_DESKTOPVK
    gates around Windows-only APIs. Remaining CA1416 noise from MonoGame annotations
    is suppressed here.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!--
    Suppress NETSDK1206 repo-wide (transitive Libuv RID ads).
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

</Project>
